# Keep the build context small and the image clean.
# Without this, `COPY . .` would copy the whole virtual environment into the
# image - hundreds of megabytes of Windows binaries that cannot even run in a
# Linux container.

# --- Virtual environments ----------------------------------------------------
venv/
env/
.venv/

# --- Python bytecode ---------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Secrets -----------------------------------------------------------------
# Real credentials are passed in at runtime via env_file, never baked into
# the image.
.env
.env.*
!.env.example

# --- Scan data and reports ---------------------------------------------------
# These describe real infrastructure and are mounted as volumes at runtime.
scans/
instance/
static/screenshots/*
!static/screenshots/.gitkeep
attack_surface.json
*.pdf
*_report.html
*_report.json

# --- Version control and editors ---------------------------------------------
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Docs --------------------------------------------------------------------
# Not needed to run the app.
docs/
*.md
!README.md
