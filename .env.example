# SurfaceWatch configuration
# ----------------------
# Copy this file to .env and fill in whatever you want to use.
#
#   cp .env.example .env
#
# EVERY setting below is optional. SurfaceWatch runs with all of them blank -
# you simply get fewer features. Nothing here costs money: both API keys
# have free tiers that are plenty for one small business.
#
# Never commit your real .env file. It is already in .gitignore.


# --- Known weakness lookup (free) ------------------------------------------
# Without a key the NIST database still works, just slowly (about one request
# every 7 seconds). A free key makes it roughly 10x faster.
# Get one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=


# --- Passive discovery via Shodan (free tier, optional) --------------------
# Lets SurfaceWatch ask a public database what it already knows about your servers,
# without touching them. Leave blank to skip this entirely.
# Get one at: https://account.shodan.io/
SHODAN_API_KEY=


# --- Email alerts (optional) -----------------------------------------------
# Leave SMTP_HOST or ALERT_TO blank to turn alerting off completely.
# SurfaceWatch only emails you when something genuinely needs you: a critical
# finding, a new web address, a sharp rise in exposure, or a certificate
# about to expire.
#
# Gmail users: create an App Password, do NOT use your normal password.
#   https://support.google.com/accounts/answer/185833
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_TO=
SMTP_USE_TLS=true


# --- Automatic monitoring --------------------------------------------------
# Domains to watch automatically when the app starts, comma separated.
# Example: SURFACEWATCH_TARGETS=acme.com,acme.co.uk
SURFACEWATCH_TARGETS=


# --- Web application -------------------------------------------------------
# Change this to any long random string before putting the dashboard on a
# network other people can reach.
SECRET_KEY=change-this-to-something-random


# --- Container settings ----------------------------------------------------
# Used by docker-compose.yml so scheduled scans run in your local time.
TZ=UTC
